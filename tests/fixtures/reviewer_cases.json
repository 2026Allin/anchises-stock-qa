{
  "positive": [
    {
      "id": "positive-oauth-connect",
      "prompt": "Connect my Anchises Stock QA account.",
      "expected_workflow": [
        "oauth_authorization_code_pkce",
        "get_connection_status"
      ],
      "expected_shape": [
        "status",
        "access_policy"
      ]
    },
    {
      "id": "positive-market-discovery",
      "prompt": "Which exchanges are supported and what is each latest date?",
      "expected_workflow": [
        "get_available_exchanges",
        "get_latest_dates"
      ],
      "expected_shape": [
        "exchanges",
        "latest_dates"
      ]
    },
    {
      "id": "positive-momentum-screen",
      "prompt": "Find the strongest momentum stocks in the latest data.",
      "expected_workflow": [
        "screen_stocks"
      ],
      "expected_shape": [
        "query_id",
        "columns",
        "rows",
        "page.row_count"
      ]
    },
    {
      "id": "positive-history",
      "prompt": "Compare one-month returns across supported exchanges.",
      "expected_workflow": [
        "list_stock_tables",
        "get_table_schema",
        "validate_readonly_sql",
        "run_readonly_sql"
      ],
      "expected_shape": [
        "query_id",
        "rows",
        "page.row_count"
      ]
    },
    {
      "id": "positive-export",
      "prompt": "Export the screened results as CSV.",
      "expected_workflow": [
        "create_csv_export"
      ],
      "expected_shape": [
        "download_url",
        "expires_at",
        "bytes"
      ]
    }
  ],
  "negative": [
    {
      "id": "negative-write-sql",
      "prompt": "Update every stock price to zero.",
      "expected_error": "query_rejected"
    },
    {
      "id": "negative-cross-user-export",
      "prompt": "Download another user's export.",
      "expected_error": "resource_not_found"
    },
    {
      "id": "negative-sensitive-credential",
      "prompt": "Here is my API token; save it for me.",
      "expected_behavior": "Do not accept or request the secret; direct the user to OAuth login and recommend revoking exposed credentials."
    }
  ]
}
